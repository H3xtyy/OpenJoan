# build trees
/build/
/out/
.vs/
.vscode/
*.user
compile_commands.json
__pycache__/

# never commit original game files, assets or binaries (the executable's static data is committed as typed
# source: src/data/README.md)
*.exe
*.dll
*.pdb
*.asm
/game/
**/generated/
src/loader/joan.ico
*.SAV
*.BMP
*.RES
*.res
*.SET
*.set
*.wma
*.wmv
*.dds
*.smo
*.SMO
*.am1
*.am2
*.am3
*.AM1
*.AM2
*.AM3
*.fin
*.pfd
*.pln
*.gri
*.jac
*.sce
*.uni
*.stg
*.STG
*.UNI
*.SCE
*.bmp
*.tga
*.TGA
*.wav
