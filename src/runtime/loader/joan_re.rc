// SPDX-License-Identifier: GPL-3.0-or-later
// OpenJoan's own resource script. joan-re's joan_re.rc carried the game's
// two resources copied from joan.exe, the window icon (group 102) and the "Select Device" dialog 101; neither may be
// in this repository (CLAUDE.md section 3, ADR-0001 item 3). Icon 102 is OpenJoan's own artwork (openjoan.ico,
// tools/make_icon.py): the game's Window::create loads it through LoadIconA(instance, 0x66) unchanged. Dialog 101
// is not provided: its only user select_adapter 0x00462f50 is dead code in the shipped game, deleted in joan-re's
// cleanup C1, and its slot traps.
#include <windows.h>

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

102 ICON "openjoan.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "OpenJoan: reimplementation of Wars and Warriors: Joan of Arc"
            VALUE "FileVersion",     "0.1.0.0"
            VALUE "InternalName",    "openjoan"
            VALUE "LegalCopyright",  "GPL-3.0-or-later; Wars and Warriors: Joan of Arc is the property of its owners"
            VALUE "OriginalFilename", "openjoan.exe"
            VALUE "ProductName",     "OpenJoan"
            VALUE "ProductVersion",  "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
